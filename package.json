{
  "name": "mineguard360",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,DRIVER,DASHBOARD\" -c \"cyan,blue,green\" \"npm run backend\" \"npm run dev:driver\" \"npm run dev:dashboard\"",
    "backend": "tsx backend/src/index.ts",
    "dev:backend": "tsx watch backend/src/index.ts",
    "dev:driver": "vite --config driver-display/vite.config.ts driver-display",
    "dev:dashboard": "vite --config dashboard/vite.config.ts dashboard",
    "build:driver": "tsc -p driver-display/tsconfig.json && vite build --config driver-display/vite.config.ts driver-display",
    "build:dashboard": "tsc -p dashboard/tsconfig.json && vite build --config dashboard/vite.config.ts dashboard",
    "build": "npm run build:driver && npm run build:dashboard",
    "start": "tsx backend/src/index.ts",
    "deploy": "npm run build && npm start",
    "preview": "vite preview",
    "test": "vitest run",
    "test:sync": "tsx backend/src/test_sync.ts"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.12.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.15",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "vitest": "^1.3.1"
  }
}
