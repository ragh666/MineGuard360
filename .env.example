# =============================================================================
# MineGuard360 Environment Variables Template
# Copy this file to .env and adjust variables as required.
# =============================================================================

# Server Ports
BACKEND_PORT=4000
DRIVER_PORT=3000
DASHBOARD_PORT=3001

# Frontend Backend Connection (Used by Vite during build & client runtime)
VITE_BACKEND_URL=https://mineguard360-backend.onrender.com

# Operational Mode (true = POC / SIMULATION)
SIMULATION_MODE=true

# External AI/ML Model Endpoint (Optional)
# If left blank, server uses built-in mock fallback adapter (POC / SIMULATION)
# When your teammate deploys the trained model, specify its base URL:
# AI_SERVICE_URL=http://localhost:5000
AI_SERVICE_URL=
